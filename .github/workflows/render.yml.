name: Render video
on:
  workflow_dispatch:
  push:
    paths: ["short-2050.zip"]
jobs:
  render:
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: ffmpeg
        run: sudo apt-get update && sudo apt-get install -y ffmpeg unzip
      - name: Unpack
        run: unzip -q short-2050.zip
      - name: Install
        working-directory: short-2050
        run: npm install --no-audit --no-fund
      - name: Exact word timings (falls back to the approximate ones)
        working-directory: short-2050
        continue-on-error: true
        run: |
          node tools/whisper.mjs public/voice.mp3 ru
          node tools/plan.mjs
      - name: Render
        working-directory: short-2050
        run: |
          mkdir -p out
          npx remotion render src/index.ts Video out/final.mp4 --gl=swiftshader --concurrency=2
      - uses: actions/upload-artifact@v4
        with:
          name: video
          path: short-2050/out/final.mp4
